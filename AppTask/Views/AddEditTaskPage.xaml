<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AppTask.Views.AddEditTaskPage"
    xmlns:converter="clr-namespace:AppTask.Libraries.Converters"
    Title="AddEditTaskPage">
    <ContentPage.Resources>
        <converter:BoolToTextDecorationStrikeThroughConverter
            x:Key="BoolToTextDecorationStrikeThroughConverter" />
    </ContentPage.Resources>
    <ScrollView>
        <Grid>
            <BoxView
                VerticalOptions="Start"
                HeightRequest="5"
                Color="{StaticResource Black}" />
            <VerticalStackLayout
                Padding="15"
                Spacing="10">
                <Button
                    Text="X"
                    Padding="0"
                    HorizontalOptions="End"
                    Clicked="CloseModal"
                    MinimumHeightRequest="31"
                    MinimumWidthRequest="31" />
                <Border
                    StrokeShape="RoundRectangle, 10">
                    <Entry
                        x:Name="Entry_TaskName"
                        Placeholder="Tarefa" />
                </Border>
                <Label
                    x:Name="Label_TaskName_Required"
                    Text="O campo é obrigatório!"
                    TextColor="Red"
                    IsVisible="False"
                    Margin="0, -7, 0 ,5" />
                <Border
                    StrokeShape="RoundRectangle, 10">
                    <Editor
                        x:Name="Editor_TaskDescription"
                        Placeholder="Descrição"
                        HeightRequest="150" />
                </Border>
                <Label
                    x:Name="Label_TaskDescription_Required"
                    Text="O campo é obrigatório!"
                    TextColor="Red"
                    IsVisible="False"
                    Margin="0, -7, 0 ,5" />
                <Border
                    StrokeShape="RoundRectangle, 10">
                    <DatePicker
                        x:Name="DatePicker_TaskDate" />
                </Border>
                <StackLayout
                    HeightRequest="31"
                    Orientation="Horizontal">
                    <Label
                        Text="Etapas (Subtarefas)"
                        VerticalOptions="Center" />
                    <Button
                        HorizontalOptions="EndAndExpand"
                        Text="+"
                        Clicked="AddStep"
                        Padding="0"
                        MinimumHeightRequest="31"
                        MinimumWidthRequest="31" />
                </StackLayout>
                <StackLayout
                    x:Name="BindableLayout_Steps">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                ColumnDefinitions="30, *, 30">
                                <CheckBox
                                    IsChecked="{Binding IsCompleted}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    TextDecorations="{Binding IsCompleted, Converter={StaticResource BoolToTextDecorationStrikeThroughConverter}}"
                                    VerticalOptions="Center" />
                                <Image
                                    Grid.Column="2"
                                    Source="trash.png"
                                    WidthRequest="25">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnTapToDelete"
                                            CommandParameter="{Binding .}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>
            </VerticalStackLayout>
            <Button
                Margin="15"
                VerticalOptions="End"
                HorizontalOptions="Center"
                Text="Salvar"
                Clicked="SaveData" />
        </Grid>
    </ScrollView>
</ContentPage>