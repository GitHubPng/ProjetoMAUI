<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMVVMCommunityToolkit.Views.PubSubPage"
             xmlns:vm="clr-namespace:AppMVVMCommunityToolkit.ViewModels"
             Title="PubSubPage">
    <ContentPage.BindingContext>
        <vm:PubSubPageViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout Padding="20">
        <Entry Placeholder="Digite uma mensagem pra tela anterior." Text="{Binding InputText}"/>
        <Button Text="Enviar mensagem" Command="{Binding SendTextCommand}"/>
        <Button
            Margin="0, 10" Text="Adicionar nova pessoa" Command="{Binding AddNewPersonCommand}"/>
    </VerticalStackLayout>
</ContentPage>