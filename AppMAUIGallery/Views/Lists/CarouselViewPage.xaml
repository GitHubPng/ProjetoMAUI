<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Lists.CarouselViewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CarouselViewPage">

    <ContentPage.Resources>

        <Style TargetType="BoxView" x:Key="IndicatorStyle">

            <Setter Property="VisualStateManager.VisualStateGroups">

                <VisualStateGroupList>

                    <VisualStateGroup x:Name="CommonStates">

                        <VisualState x:Name="Normal">

                            <VisualState.Setters>

                                <Setter Property="Color" Value="#DFD8F7" />

                            </VisualState.Setters>

                        </VisualState>

                        <VisualState x:Name="Selected">

                            <VisualState.Setters>

                                <Setter Property="Color" Value="#512BD4" />

                            </VisualState.Setters>

                        </VisualState>

                    </VisualStateGroup>

                </VisualStateGroupList>

            </Setter>

            <Setter Property="Color" Value="#512BD4"/>

        </Style>

    </ContentPage.Resources>

    <Grid>
        <CarouselView
            x:Name="CarouselViewControl"
            IndicatorView="IndicatorViewControl"
            IsSwipeEnabled="True"
            Loop="False"
            PeekAreaInsets="50"
            Position="0">

            <CarouselView.ItemsLayout>

                <LinearItemsLayout
                    ItemSpacing="0"
                    Orientation="Horizontal"
                    SnapPointsAlignment="Center"
                    SnapPointsType="Mandatory" />

            </CarouselView.ItemsLayout>

            <CarouselView.ItemTemplate>

                <DataTemplate>

                    <VerticalStackLayout Margin="10" BackgroundColor="#f2f2f2">

                        <Label
                            Padding="10"
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            Text="{Binding Name}" />

                        <Label
                            Padding="10"
                            Text="{Binding Description}"
                            TextColor="Gray" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="100">

                            <Label Text="{Binding LaunchYear}" />
                            <Label Text="{Binding Duration}" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </DataTemplate>

            </CarouselView.ItemTemplate>

        </CarouselView>
        <!--<IndicatorView
            x:Name="IndicatorViewControl"
            Margin="10"
            HorizontalOptions="Center"
            IndicatorColor="#DFD8F7"
            IndicatorSize="16"
            SelectedIndicatorColor="#512BD4"
            VerticalOptions="End"
            IndicatorsShape="Circle"/> -->
        <!-- Indicador com template -->

        <IndicatorView
            x:Name="IndicatorViewControl"
            Margin="10"
            HorizontalOptions="Center"
            IndicatorColor="Transparent"
            IndicatorSize="16"
            SelectedIndicatorColor="#512BD4"
            VerticalOptions="End"
            IndicatorsShape="Circle">

            <IndicatorView.IndicatorTemplate>

                <DataTemplate>

                    <BoxView
                        WidthRequest="20"
                        HeightRequest="10"
                        Style="{StaticResource IndicatorStyle}"
                        CornerRadius="3"
                     />

                </DataTemplate>

            </IndicatorView.IndicatorTemplate>

        </IndicatorView>

    </Grid>

</ContentPage>