<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AppMAUIGallery.Views.Components.Forms.RadioButtonPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="RadioButtonPage">
    <VerticalStackLayout Padding="10">
        <StackLayout>
            <Label
                HorizontalOptions="Center"
                Text="Qual linguagem de progamação você mais gosta?"
                VerticalOptions="Center" />
            <RadioButton CheckedChanged="RadioButton_CheckedChanged" Content="C#" />
            <RadioButton CheckedChanged="RadioButton_CheckedChanged" Content="Java" />
            <RadioButton
                BorderColor="Blue"
                BorderWidth="1"
                CheckedChanged="RadioButton_CheckedChanged"
                Content="JavaScript"
                CornerRadius="10" />
            <Label x:Name="LblResultAsk01" />
        </StackLayout>
        <StackLayout>
            <Label
                HorizontalOptions="Center"
                Text="Qual linguagem de progamação você mais gosta?"
                VerticalOptions="Center" />
            <RadioButton Content="C#" />
            <RadioButton Content="Java" />
            <RadioButton Content="JavaScript" />
        </StackLayout>
        <StackLayout RadioButtonGroup.GroupName="ask02">
            <Label
                HorizontalOptions="Center"
                Text="Qual é o mascote do NET MAUI?"
                VerticalOptions="Center" />
            <RadioButton Value="Robot">
                <RadioButton.Content>
                    <HorizontalStackLayout>
                        <Label Text="Robot" />
                        <Image HeightRequest="50" Source="dotnet_bot.png" />
                    </HorizontalStackLayout>
                </RadioButton.Content>
            </RadioButton>
            <RadioButton Content="Java" />
            <RadioButton Content="JavaScript" />
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>